# 真实语料 profile：《中医内科学》884 块
# 用法：RAG_ENV_FILE=config/tcm.env .venv/bin/rag-mcp
RAG_BACKEND=sqlite
RAG_DB_PATH=rag.db

RAG_PRINCIPAL_ID=local-dev
RAG_PRINCIPAL_GROUPS=all
RAG_PRINCIPAL_MAX_LEVEL=internal

RAG_MAX_TOP_K=20
RAG_DEFAULT_TOP_K=8
RAG_RECALL_DEPTH=50
RAG_PER_DOC_LIMIT=2
RAG_RELEVANCE_FLOOR=0.25
RAG_DENSE_FLOOR=0.55
RAG_SNIPPET_CHARS=300
RAG_MAX_WINDOW=3
RAG_MAX_FETCH_CHARS=4000
RAG_MAX_RESOURCE_CHARS=8000
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# 向量模型（与建库时一致，否则向量空间对不上）
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_BATCH=10
RAG_EMBEDDING_TIMEOUT=5

# 重排：百炼原生端点（实测 /compatible-mode/v1/rerank 与 /reranks 均 404）
RAG_RERANK=on
RAG_RERANK_PROVIDER=dashscope
RAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com
RAG_RERANK_MODEL=gte-rerank-v2
RAG_RERANK_TIMEOUT=10

# ---- 阈值：由 `python -m rag_mcp.calibrate` 生成（DESIGN §18.2.4）----
# 22 条考题实测：反例最高 0.1213 < 正例最低 0.1725 → 可分离
RAG_RELEVANCE_FLOOR=0.15
RAG_CONFIDENCE_HIGH=0.55
RAG_CONFIDENCE_MEDIUM=0.35
RAG_DENSE_FLOOR=0.6

# 检索模式：auto | hybrid | lexical | dense（安全开关，只改走哪几路）
RAG_RETRIEVAL_MODE=auto
