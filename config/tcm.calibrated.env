# 由 `python -m rag_mcp.calibrate` 生成，请勿手改
# 阈值 overlay：backend/db/registry 已固定；
# embedding / rerank 端点与 key 仍从根 .env 继承
# 索引: SQLite 索引（中医内科学 › 正文）
# 重排: dashscope:gte-rerank-v2
# 考题: 22 条（正例 18 / 反例 4）
# 分离: 反例最高 0.1213 < 正例最低 0.1725

RAG_BACKEND=sqlite
RAG_DB_PATH=rag.db
RAG_REGISTRY_PATH=config/tcm.registry.json

RAG_RELEVANCE_FLOOR=0.15
RAG_CONFIDENCE_HIGH=0.55
RAG_CONFIDENCE_MEDIUM=0.35
RAG_DENSE_FLOOR=0.6
