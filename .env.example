# 语料与词表（MVP 用 JSON 模拟索引；生产替换为真实检索后端）
RAG_DATA_PATH=
RAG_REGISTRY_PATH=

# 调用方身份。stdio 下它来自**进程启动上下文**，绝不由工具参数传入（DESIGN §8.2）
RAG_PRINCIPAL_ID=local-dev
RAG_PRINCIPAL_GROUPS=all
RAG_PRINCIPAL_MAX_LEVEL=internal

# ---- 预算上限（唯一来源：src/rag_mcp/budget.py；改这里就够了） ----
RAG_MAX_TOP_K=20
RAG_DEFAULT_TOP_K=8
RAG_RECALL_DEPTH=50
RAG_PER_DOC_LIMIT=2
RAG_RELEVANCE_FLOOR=0.25
RAG_DENSE_FLOOR=0.55
RAG_SNIPPET_CHARS=300
RAG_MAX_WINDOW=3
RAG_MAX_FETCH_CHARS=4000
RAG_MAX_RESOURCE_CHARS=8000

# ---- 切分（小块入库，父块返回） ----
RAG_CHUNK_SIZE=360
RAG_CHUNK_OVERLAP=48

# ---- 向量模型（OpenAI 兼容 /embeddings）。三项都填才会启用语义召回 ----
# 不填 = 使用本地词法桩：管线跑得通，但没有语义能力（retrieval_mode=lexical）
# 例（阿里百炼）：
#   RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   RAG_EMBEDDING_MODEL=text-embedding-v3
#   RAG_EMBEDDING_API_KEY=sk-xxxx
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
# key 也可以写成 DASHSCOPE_API_KEY 或 BAILIAN_API_KEY，程序都认
RAG_EMBEDDING_API_KEY=
# text-embedding-v3 兼容模式批量上限为 10，调大会整批失败
RAG_EMBEDDING_BATCH=10
RAG_EMBEDDING_TIMEOUT=10

# ---- 重排模型（兼容 /rerank）。不填 = 启发式重排；RAG_RERANK=off = 显式关闭 ----
RAG_RERANK=on
RAG_RERANK_BASE_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT=10

# 说明：本 server 只支持 stdio，没有 transport 开关（DESIGN §3.1）。
# 多身份 = 客户端启动多个进程，一个进程一个身份。
